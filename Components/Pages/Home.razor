@page "/"
@layout LandingLayout

<PageTitle>EduTrack</PageTitle>

<section class="container py-5">
    <div class="row align-items-center g-4">
        <div class="col-md-6">
            <h1 class="display-5 fw-bold">Manage your students and enrollments in one place.</h1>
            <p class="lead text-muted">Student records, enrollment tracking and a quick overview dashboard for admins, teachers and students.</p>
            <a href="dashboard" class="btn btn-dark me-2">Get started</a>
            <a href="dashboard" class="btn btn-outline-dark">Log in</a>
        </div>
        <div class="col-md-6">
            <div class="border rounded bg-light d-flex align-items-center justify-content-center" style="height:260px">
                Dashboard preview
            </div>
        </div>
    </div>
</section>

<section id="features" class="container pb-5">
    <div class="row g-3">
        <div class="col-md-4"><div class="card p-3 h-100"><h5>Students</h5><p class="text-muted mb-0">Register, search, edit and delete student records.</p></div></div>
        <div class="col-md-4"><div class="card p-3 h-100"><h5>Enrollments</h5><p class="text-muted mb-0">Assign sections and track enrollment status.</p></div></div>
        <div class="col-md-4"><div class="card p-3 h-100"><h5>Dashboard</h5><p class="text-muted mb-0">A quick view of totals and recent activity.</p></div></div>
    </div>
</section>

<section id="roles" class="container pb-5">
    <h2 class="h4 mb-3">Built for every role</h2>
    <div class="row g-3">
        <div class="col-md-4"><div class="card p-3 h-100"><h5>Admin</h5><p class="text-muted mb-0">Manages students and enrollments.</p></div></div>
        <div class="col-md-4"><div class="card p-3 h-100"><h5>Teacher</h5><p class="text-muted mb-0">Views their sections and students.</p></div></div>
        <div class="col-md-4"><div class="card p-3 h-100"><h5>Student</h5><p class="text-muted mb-0">Checks their enrollment and course progress.</p></div></div>
    </div>
</section>