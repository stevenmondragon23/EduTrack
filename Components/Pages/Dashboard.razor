@page "/dashboard"

<PageTitle>Dashboard</PageTitle>

<h1 class="h3 mb-4">Dashboard</h1>

<div class="row g-3 mb-4">
    @foreach (var k in kpis)
    {
        <div class="col-12 col-sm-4">
            <div class="card p-3">
                <small class="text-muted">@k.Label</small>
                <div class="fs-2 fw-bold">@k.Value</div>
            </div>
        </div>
    }
</div>

<div class="row g-3">
    <div class="col-lg-7">
        <div class="card p-3 mb-3">
            <h5>Enrollments by section</h5>
            <div class="border rounded bg-light d-flex align-items-center justify-content-center text-muted" style="height:170px">No data yet</div>
        </div>
        <div class="card p-3">
            <h5>Recent activity</h5>
            @if (activity.Count == 0)
            {
                <p class="text-muted mb-0">No activity yet.</p>
            }
            else
            {
                <ul class="list-group list-group-flush">
                    @foreach (var a in activity)
                    {
                        <li class="list-group-item">@a</li>
                    }
                </ul>
            }
        </div>
    </div>

    <div class="col-lg-5">
        <div class="card p-3 mb-3">
            <h5>My courses · current grade</h5>
            @if (courses.Count == 0)
            {
                <p class="text-muted mb-0">No courses yet.</p>
            }
            else
            {
                @foreach (var c in courses)
                {
                    <div class="mb-2">
                        <div class="d-flex justify-content-between"><span>@c.Name</span><strong>@c.Grade%</strong></div>
                        <div class="progress"><div class="progress-bar bg-dark" style="width: @(c.Grade)%"></div></div>
                    </div>
                }
            }
        </div>

        <div class="card p-3">
            <h5>What-if calculator</h5>
            <label class="form-label mb-0">Course</label>
            <input type="text" class="form-control mb-2" placeholder="Select course" />
            <label class="form-label mb-0">Target grade</label>
            <input type="text" class="form-control mb-3" placeholder="e.g. 90" />
            <p class="mb-3">Needed on final: <strong>—</strong></p>
            <button type="button" class="btn btn-dark">Calculate</button>
        </div>
    </div>
</div>

@code {
    record Kpi(string Label, int Value);
    record Course(string Name, int Grade);

    // Todo vacío: luego estas listas se llenarán con datos reales
    List<Kpi> kpis = new()
    {
        new("Total students", 0),
        new("Active enrollments", 0),
        new("Pending enrollments", 0)
    };
    List<Course> courses = new();
    List<string> activity = new();
}