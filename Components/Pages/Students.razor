@page "/students"
@rendermode InteractiveServer

<PageTitle>Students</PageTitle>

<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
    <h1 class="h3 mb-0">Students</h1>
    <button type="button" class="btn btn-dark">Add student</button>
</div>

<input type="search" class="form-control mb-3" placeholder="Search by name or email..."
       @bind="search" @bind:event="oninput" />

@if (students.Count == 0)
{
    <div class="card p-4 text-center">
        <p class="fw-semibold mb-1">No students yet</p>
        <p class="text-muted mb-0">Click "Add student" to register the first one.</p>
    </div>
}
else
{
    <div class="table-responsive card">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th>Name</th>
                    <th>Email</th>
                    <th>Grade / Section</th>
                    <th>Status</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var s in Filtered)
                {
                    <tr>
                        <td>@s.Name</td>
                        <td>@s.Email</td>
                        <td>@s.Section</td>
                        <td><span class="badge @(s.Active ? "text-bg-dark" : "text-bg-secondary")">@(s.Active ? "Active" : "Inactive")</span></td>
                        <td class="text-end">
                            <button type="button" class="btn btn-sm btn-outline-dark">Edit</button>
                            <button type="button" class="btn btn-sm btn-outline-danger">Delete</button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    @if (!Filtered.Any())
    {
        <p class="text-muted mt-3">No students match your search.</p>
    }
}

@code {
    record Student(string Name, string Email, string Section, bool Active);

    string search = "";

    // Lista vacía: luego vendrá de la base de datos
    List<Student> students = new();

    IEnumerable<Student> Filtered => students.Where(s =>
        s.Name.Contains(search, StringComparison.OrdinalIgnoreCase) ||
        s.Email.Contains(search, StringComparison.OrdinalIgnoreCase));
}